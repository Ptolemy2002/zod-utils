{
    "name": "@ptolemy2002/zod-utils",
    "version": "1.8.1",
    "private": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/core/index.d.ts",
            "default": "./dist/core/index.js"
        },
        "./zod": {
            "types": "./dist/zod/index.d.ts",
            "default": "./dist/zod/index.js"
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "core": [
                "dist/core/index.d.ts"
            ],
            "zod": [
                "dist/zod/index.d.ts"
            ]
        }
    },
    "files": [
        "/dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Ptolemy2002/zod-utils",
        "directory": "lib"
    },
    "scripts": {
        "prepare": "npx ts-patch install -s && npx typesync",
        "build": "bash ./scripts/build.sh",
        "_build": "tsc --project ./tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "uninstall": "bash ./scripts/uninstall.sh",
        "reinstall": "bash ./scripts/reinstall.sh",
        "release": "bash ./scripts/release.sh",
        "release-patch": "bash ./scripts/release.sh patch",
        "release-minor": "bash ./scripts/release.sh minor",
        "release-major": "bash ./scripts/release.sh major",
        "test:package": "bash ./scripts/test-package.sh"
    },
    "peerDependencies": {
        "zod": "^4.3.6"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/is-callable": "^1.1.2",
        "@types/jest": "^29.5.0",
        "@types/node": "^25.3.5",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "ts-patch": "^3.3.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-transform-paths": "^3.5.3",
        "valibot": "^1.5.0",
        "zod": "^4.3.6"
    },
    "dependencies": {
        "@standard-schema/spec": "^1.1.0",
        "is-callable": "^1.2.7"
    }
}
